{
  "name": "volunteer-intent-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "check": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tracer": "node --import tsx --env-file-if-exists=.env.local src/pipeline/tracer.ts",
    "eval": "node --import tsx --env-file-if-exists=.env.local src/eval/report.ts",
    "demo:reset": "rm -f run.uploaded.json sent-marks.jsonl && rm -rf data/uploads",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sweep": "node --import tsx --env-file-if-exists=.env.local src/pipeline/sweep-run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lefthook": "2.1.10",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.39",
    "ai": "^7.0.58",
    "csv-parse": "^7.0.2",
    "effect": "3.22.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
